{
  "app": {
    "name": "BusBeacon",
    "version": "1.0.0",
    "build": "2026.01.16",
    "description": "Signal bus drivers with accessibility and multilingual support",
    "author": "BusBeacon Team",
    "license": "MIT",
    "repository": "https://github.com/izzyinnis-star/Bestbusbeacon"
  },
  "platform": {
    "thunkable": {
      "type": "Thunkable X",
      "minimumVersion": "480"
    },
    "ios": {
      "minimumVersion": "12.0",
      "targetVersion": "17.0",
      "bundleId": "com.busbeacon.app"
    },
    "android": {
      "minimumSdk": 23,
      "targetSdk": 34,
      "packageName": "com.busbeacon.app"
    }
  },
  "permissions": {
    "location": {
      "required": false,
      "description": "Used to detect nearby bus stops",
      "ios": "NSLocationWhenInUseUsageDescription",
      "android": "ACCESS_FINE_LOCATION"
    },
    "notifications": {
      "required": false,
      "description": "Send notifications when beacon is active",
      "ios": "NSUserNotificationsUsageDescription",
      "android": "POST_NOTIFICATIONS"
    },
    "camera": {
      "required": false,
      "description": "Use flash as additional beacon (optional)",
      "ios": "NSCameraUsageDescription",
      "android": "CAMERA"
    }
  },
  "features": {
    "beacon": {
      "defaultDuration": 300,
      "maxDuration": 600,
      "flashInterval": 500,
      "autostopBatteryThreshold": 10,
      "warningBatteryThreshold": 20,
      "colors": {
        "primary": "#FFEB3B",
        "secondary": "#FFFFFF",
        "highContrastPrimary": "#000000",
        "highContrastSecondary": "#FFFFFF"
      }
    },
    "location": {
      "updateInterval": 30,
      "accuracy": "high",
      "nearbyStopsRadius": 0.5
    },
    "accessibility": {
      "screenReader": true,
      "highContrast": true,
      "adjustableTextSize": true,
      "minimumTouchTarget": 44,
      "hapticFeedback": true
    },
    "multilingual": {
      "defaultLanguage": "en",
      "autoDetect": true,
      "supportedLanguages": [
        "en",
        "es",
        "fr",
        "zh",
        "ar"
      ]
    }
  },
  "colors": {
    "primary": "#2196F3",
    "primaryDark": "#1976D2",
    "primaryLight": "#BBDEFB",
    "accent": "#FFC107",
    "beaconYellow": "#FFEB3B",
    "beaconOrange": "#FF9800",
    "error": "#F44336",
    "success": "#4CAF50",
    "textPrimary": "#212121",
    "textSecondary": "#757575",
    "background": "#FFFFFF",
    "backgroundDark": "#F5F5F5"
  },
  "typography": {
    "fontFamily": "System",
    "sizes": {
      "headingLarge": 32,
      "headingMedium": 24,
      "headingSmall": 20,
      "body": 16,
      "bodyLarge": 18,
      "button": 18,
      "caption": 14,
      "timer": 32
    },
    "weights": {
      "bold": "bold",
      "normal": "normal"
    }
  },
  "storage": {
    "localDB": {
      "keys": {
        "language": "app.language",
        "visualBeacon": "beacon.visual",
        "audioAlert": "beacon.audio",
        "vibration": "beacon.vibration",
        "flashLight": "beacon.flashLight",
        "highContrast": "accessibility.highContrast",
        "textSize": "accessibility.textSize",
        "notifications": "notifications.enabled",
        "notificationSound": "notifications.sound"
      }
    }
  },
  "screens": [
    {
      "name": "HomeScreen",
      "route": "/",
      "description": "Main landing screen with beacon activation"
    },
    {
      "name": "BeaconActiveScreen",
      "route": "/beacon",
      "description": "Full-screen visual beacon"
    },
    {
      "name": "SettingsScreen",
      "route": "/settings",
      "description": "App configuration and preferences"
    },
    {
      "name": "HelpScreen",
      "route": "/help",
      "description": "User guidance and support"
    }
  ],
  "assets": {
    "sounds": [
      {
        "name": "beacon_alert.mp3",
        "description": "Audio alert for beacon",
        "duration": 2000,
        "loop": true
      }
    ],
    "images": [
      {
        "name": "app_icon.png",
        "size": "1024x1024",
        "description": "App icon"
      },
      {
        "name": "splash_screen.png",
        "size": "2048x2048",
        "description": "Splash screen image"
      }
    ]
  },
  "analytics": {
    "enabled": false,
    "note": "Privacy-first - no user tracking"
  },
  "thirdPartyServices": {
    "none": "No third-party services or APIs used in v1.0"
  }
}
